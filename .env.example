# ---------------------------------------------------------------------------
# agent-eval configuration. Copy to .env and fill in.
# This file is committed; it must never contain a real value.
# ---------------------------------------------------------------------------

# --- Frontend (PUBLIC) -----------------------------------------------------
# VITE_ variables are compiled into the browser bundle and are readable by
# anyone who loads the page. Only ever put public configuration here.
# Leave empty for local development, where Vite proxies /v1 to the API.
VITE_API_BASE_URL=

# --- Control plane (PRIVATE — server only) ---------------------------------
# 64 hex characters. Required before any provider credential can be stored;
# the server refuses to write a secret it cannot encrypt. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT key per environment, and do not rotate it casually:
# stored credentials become undecryptable and must be re-entered.
AGENT_EVAL_ENCRYPTION_KEY=

# Signing key identifier recorded in every evidence signature.
SIGNING_KEY_ID=

PORT=
HOST=

# Execution. Both default to off: the platform accepts runs it cannot execute
# and says so on /v1/ready rather than silently queueing them forever.
AGENT_EVAL_MODEL_EXEC=
AGENT_EVAL_LOCAL_EXEC=
WORKER_POLL_MS=

# --- Model providers (PRIVATE — server only) -------------------------------
# Fallbacks used when a run does not name a stored credential. Storing
# credentials through the dashboard is preferred: those are encrypted,
# tenant-scoped, revocable and attributable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
MINIMAX_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# --- Local inference runtimes ----------------------------------------------
# Endpoints, not secrets. A deployed control plane cannot reach a developer's
# localhost, so these must be addresses it can actually resolve.
OLLAMA_BASE_URL=
VLLM_BASE_URL=
TENSORRT_LLM_BASE_URL=
NIM_BASE_URL=

# --- CLI -------------------------------------------------------------------
AGENT_EVAL_URL=
AGENT_EVAL_API_KEY=
# Read only by `credentials add`, never a command-line flag.
AGENT_EVAL_PROVIDER_KEY=
