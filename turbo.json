{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    // dependsOn ^build, NOT ^typecheck.
    //
    // Typechecking a consumer needs the producer's emitted .d.ts, and only
    // `build` emits those. With ^typecheck the SDK was type-checked but never
    // built, so on a clean checkout @agent-eval/cli could not resolve
    // @agent-eval/sdk at all -- and the resulting `any` produced a second,
    // misleading implicit-any error downstream. It passed locally only because
    // dist/ happened to survive an earlier build.
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
